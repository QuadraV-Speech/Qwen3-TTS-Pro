+    requests = {req_id: _steady_codec_request(req_id) for req_id in ("r1", "r2")}
+    for req_id in requests:
+        adapter.get_req_chunk[req_id] = 2
+    adapter._finished_load_reqs.add("r1")
+    wait_calls = []
+
+    def _arrive_during_wait(timeout):
+        wait_calls.append(timeout)
+        adapter._finished_load_reqs.add("r2")
+        adapter._codec_rendezvous_arrival_epoch += 1
+
+    monkeypatch.setattr(adapter._codec_rendezvous_cond, "wait", _arrive_during_wait)
+
+    selected = adapter._select_codec_rendezvous_ready(requests)
+
+    assert wait_calls
+    assert selected == {"r1", "r2"}
+    assert adapter._codec_rendezvous_stats["cause_target"] == 1

+    def _append_streaming_text_conditioning(
+        self,
+        info_dict: dict[str, Any],
+        *,
+        device: torch.device,
+        dtype: torch.dtype,
+    ) -> bool:
+        """Consume a live text delta into the remaining dual-track queue."""
+        text_delta = info_dict.get("qwen3_tts_streaming_text_delta")
+        text_delta = text_delta if isinstance(text_delta, str) else ""
+        token_ids_raw = info_dict.get("qwen3_tts_streaming_text_token_ids")
+        if isinstance(token_ids_raw, torch.Tensor):
+            token_ids = [int(token_id) for token_id in token_ids_raw.reshape(-1).tolist()]
+        elif isinstance(token_ids_raw, list | tuple) and all(
+            isinstance(token_id, int) and not isinstance(token_id, bool) for token_id in token_ids_raw
+        ):
+            token_ids = [int(token_id) for token_id in token_ids_raw]
+        else:
+            token_ids = []
+        input_done = info_dict.get("qwen3_tts_streaming_input_done") is True
+        if not text_delta and not token_ids and not input_done:
+            return False
+
+        payload: OmniPayload = info_dict
+        hs = payload.setdefault("hidden_states", {})
+        meta = payload.setdefault("meta", {})
+        tail = hs.get("trailing_text")
+        text_offset = max(0, int(meta.get("talker_text_offset", 0) or 0))
+        if isinstance(tail, torch.Tensor) and tail.ndim == 2:
+            remaining = tail[min(text_offset, int(tail.shape[0])) :]
+            # Every independently-tokenized fragment ends in a TTS-EOS text
+            # row. While the producer is still appending text that terminal row
+            # becomes an interior boundary and must be replaced, not retained.
+            if bool(meta.get("trailing_text_has_eos", False)) and int(remaining.shape[0]) > 0:
+                remaining = remaining[:-1]
+            remaining = remaining.to(device=device, dtype=dtype)
+        else:
+            remaining = torch.empty(
+                (0, int(self.talker_config.hidden_size)),
+                device=device,
+                dtype=dtype,
+            )
+
+        if token_ids:
+            appended = self._prompt_builder.build_streaming_text_hidden_from_token_ids(
+                token_ids,
+                append_eos=input_done,
+            )
+        else:
+            appended = self._prompt_builder.build_streaming_text_hidden(
+                text_delta,
+                append_eos=input_done,
+            )
+        appended = appended.to(
+            device=device,
+            dtype=dtype,
+        )
+        new_tail = torch.cat((remaining, appended), dim=0)
+        hs["trailing_text"] = new_tail.detach()
+        meta["talker_text_offset"] = 0
+        meta["trailing_text_has_eos"] = input_done
+        meta["qwen3_tts_streaming_input_open"] = not input_done
+        logger.debug(
+            "Qwen3-TTS live text applied: delta_chars=%d token_ids=%d done=%s remaining_rows=%d "
+            "appended_rows=%d tail_rows=%d",
+            len(text_delta),
+            len(token_ids),
+            input_done,
+            int(remaining.shape[0]),
+            int(appended.shape[0]),
+            int(new_tail.shape[0]),
+        )
+        return True

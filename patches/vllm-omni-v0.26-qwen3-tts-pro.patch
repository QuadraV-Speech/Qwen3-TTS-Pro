+    adapter, _ = build_adapter(
+        stage_id=1,
+        model_mode="generation",
+        max_num_seqs=8,
+        connector_extra={
+            "codec_rendezvous_enabled": True,
+            "codec_rendezvous_target_batch_size": 2,
+            "codec_rendezvous_min_wait_ms": 1,

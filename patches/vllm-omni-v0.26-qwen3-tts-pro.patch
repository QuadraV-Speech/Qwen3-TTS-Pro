+        parts: list[torch.Tensor] = []
+        if ids.numel() > 0:
+            parts.append(self._text_projection(self._text_embedding(ids.unsqueeze(0))))
+        if append_eos:
+            eos_ids = torch.tensor(
+                [[self._config.tts_eos_token_id]],
+                device=dev,
+                dtype=torch.long,
+            )
+            parts.append(self._text_projection(self._text_embedding(eos_ids)))
+        if not parts:
+            return torch.empty(
+                (0, int(self._talker_config.hidden_size)),
+                device=dev,
+                dtype=self._embedding_dtype,
+            )

+def _steady_codec_request(req_id: str):
+    request = _req(req_id, RequestStatus.WAITING_FOR_CHUNK)
+    request.prompt_token_ids = [0] * (16 * 97)
+    request.additional_information = {
+        "meta": {
+            "ref_context_size": 72,
+            "ref_context_included": False,
+        },
+    }
+    return request
+
+
+def test_codec_rendezvous_bypasses_first_chunk_without_sleep(build_adapter, monkeypatch):
+    adapter, _ = build_adapter(
+        stage_id=1,
+        model_mode="generation",
+        max_num_seqs=8,
+        connector_extra={"codec_rendezvous_enabled": True},
+    )
+    first = _steady_codec_request("first")
+    peer = _steady_codec_request("peer")
+    adapter.get_req_chunk[first.request_id] = 1
+    adapter.get_req_chunk[peer.request_id] = 2
+    adapter._finished_load_reqs.add(first.request_id)
+    monkeypatch.setattr(time, "sleep", lambda _seconds: pytest.fail("first chunk must not wait"))
+
+    selected = adapter._select_codec_rendezvous_ready({first.request_id: first, peer.request_id: peer})
+
+    assert selected == {first.request_id}
+    assert adapter._codec_rendezvous_stats["cause_bypass"] == 1
+
+
